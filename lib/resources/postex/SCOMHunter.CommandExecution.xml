      <Task ID="SCOMHunter.CommandExecution.Task" Accessibility="Public" Enabled="true" Target="SC!Microsoft.SystemCenter.HealthService" Timeout="300" Remotable="true">
        <Category>Custom</Category>
        <WriteAction ID="Command" TypeID="System!System.CommandExecuter">
          <ApplicationName>%SystemRoot%\System32\cmd.exe</ApplicationName>
          <WorkingDirectory />
          <CommandLine>/d /s /c echo SCOMHunter command task installed</CommandLine>
          <TimeoutSeconds>300</TimeoutSeconds>
          <RequireOutput>true</RequireOutput>
        </WriteAction>
      </Task>
    </Tasks>
  </Monitoring>
  <LanguagePacks>
