          <Name>SCOMHunter Command Execution</Name>
        </DisplayString>
        <DisplayString ElementID="SCOMHunter.CommandExecution.Task">
          <Name>Execute cmd.exe command</Name>
        </DisplayString>
      </DisplayStrings>
    </LanguagePack>
  </LanguagePacks>
